#cloud-config
hostname: ${hostname}
manage_etc_hosts: true
disable_root: false
ssh_pwauth: false

users:
  - default
  - name: root
    lock_passwd: true
    ssh_authorized_keys:
      - ${ssh_public_key}

package_update: true

packages:
  - qemu-guest-agent
  - curl
  - ca-certificates

runcmd:
  - [systemctl, enable, --now, qemu-guest-agent]
